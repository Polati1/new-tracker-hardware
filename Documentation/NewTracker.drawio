        </mxCell>
        <mxCell id="BQ5Er9MHmtifRlCAmKAv-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Function:&lt;/h1&gt;&lt;p&gt;Process images coming in from two basler cameras (via USB-A Connectors). Use AI modlel for acquisition, Use blob detection for tracking, and parallax calculations to determine distance.&lt;/p&gt;&lt;p&gt;Use UART GPIOs to send zoom/focus commands to both zoom/focus driver boards.&lt;/p&gt;&lt;p&gt;Send angular deviation data through USB-C to the master controller board for conversion to torque commands for tracking&lt;/p&gt;" vertex="1">
          <mxGeometry height="310.7" width="180" x="-445.5" y="1109.3" as="geometry" />
        </mxCell>
        <mxCell id="BQ5Er9MHmtifRlCAmKAv-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Splice cables two ways on the wiring plate." vertex="1">
          <mxGeometry height="30" width="60" x="15.620000000000001" y="1289.3" as="geometry" />
        </mxCell>
        <mxCell id="BQ5Er9MHmtifRlCAmKAv-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Current sense to sense end stop, report back to Rpi" vertex="1">
          <mxGeometry height="30" width="114.37" x="430" y="1238.25" as="geometry" />
        </mxCell>
        <mxCell id="BQ5Er9MHmtifRlCAmKAv-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Current sense to sense end stop, report back to Rpi" vertex="1">
          <mxGeometry height="30" width="114.37" x="430" y="999.3" as="geometry" />
        </mxCell>
        <mxCell id="BQ5Er9MHmtifRlCAmKAv-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="One XT-30 cables dangling loose onto the turret, and on the turret wiring plate, split into two cables." vertex="1">
          <mxGeometry height="30" width="150.31" x="-434.84000000000003" y="847.11" as="geometry" />
        </mxCell>
        <mxCell id="BQ5Er9MHmtifRlCAmKAv-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="GPIO sends logic high signal during each exposure" vertex="1">
          <mxGeometry height="30" width="114.37" x="110" y="814.85" as="geometry" />
        </mxCell>
        <mxCell id="BQ5Er9MHmtifRlCAmKAv-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="GPIO sends logic high signal during each exposure" vertex="1">
          <mxGeometry height="30" width="114.37" x="110" y="1489.85" as="geometry" />
        </mxCell>
        <mxCell id="BQ5Er9MHmtifRlCAmKAv-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="USB-C Cable provides both 5V 3A Power and Data" vertex="1">
          <mxGeometry height="30" width="114.37" x="-905.94" y="1129.3" as="geometry" />
        </mxCell>
        <mxCell id="BQ5Er9MHmtifRlCAmKAv-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Universal &quot;Controller&quot; board, but can be downgraded to just a power distribution board, if raspberry pi uses UART to communicate with the first driver board module" vertex="1">
          <mxGeometry height="30" width="356.41" x="-1238.91" y="270" as="geometry" />
        </mxCell>
        <mxCell id="BQ5Er9MHmtifRlCAmKAv-11" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Function:&lt;/h1&gt;&lt;p&gt;Power distribution from drone lipo battery, providing 5V 3A to raspberry pi and 5V 3A to onboard MCU, pass through to the BLCD motor driver modules.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Read raw error data coming from the raspberry pi, as well as raw orientation data from IMU board, run matrix calculations and CORDIC algorithm for fast PID control loop, calculating the required torques for each motor for tracking and stabilization.&lt;/p&gt;&lt;p&gt;Communicate with a radio module for wireless control of the turret (movement commands override tracking/stabilization commands).&lt;/p&gt;" vertex="1">
          <mxGeometry height="310.7" width="437.5" x="-1322.5" y="943.95" as="geometry" />
        </mxCell>
        <mxCell id="BQ5Er9MHmtifRlCAmKAv-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Unused" vertex="1">
          <mxGeometry height="30" width="114.37" x="-842.1800000000001" y="916.41" as="geometry" />
        </mxCell>
        <mxCell id="BQ5Er9MHmtifRlCAmKAv-13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2nd IMU allows for better stabilization response (optional)" vertex="1">
          <mxGeometry height="30" width="114.37" x="-1060" y="799.0699999999999" as="geometry" />
        </mxCell>
        <mxCell id="BQ5Er9MHmtifRlCAmKAv-14" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&amp;nbsp;Voltage sensing gates power to system if battery is nearly depleted.&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="114.37" x="-1332.1799999999998" y="839.85" as="geometry" />
        </mxCell>
        <mxCell id="BQ5Er9MHmtifRlCAmKAv-15" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="SPI1 here is a daisy chained SPI. Bytes must be sent for each board through the entire loop, and data the boards send back should be processed from a single unified buffer" vertex="1">
          <mxGeometry height="30" width="272.5" x="-1185" y="380" as="geometry" />
        </mxCell>
        <mxCell id="BQ5Er9MHmtifRlCAmKAv-16" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Slave 1" vertex="1">
          <mxGeometry height="30" width="272.5" x="-527.5" y="330" as="geometry" />
        </mxCell>
        <mxCell id="BQ5Er9MHmtifRlCAmKAv-17" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Slave 2" vertex="1">
